# ============================================================
# AI Company — Profile B stack
# Copy to .env and fill in real values before running `make up`
# ============================================================

# --- Infrastructure ---
POSTGRES_USER=aic
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=change_me_strong_password

# Derived URLs — must match POSTGRES_PASSWORD / REDIS_PASSWORD above
# DATABASE_URL is consumed by Paperclip; LANGGRAPH_* by LangGraph; CREWAI_* by CrewAI
DATABASE_URL=postgresql://aic:change_me_strong_password@localhost:5432/paperclip
LANGGRAPH_DATABASE_URL=postgresql://aic:change_me_strong_password@localhost:5432/langgraph
CREWAI_DATABASE_URL=postgresql://aic:change_me_strong_password@localhost:5432/crewai
REDIS_URL=redis://:change_me_strong_password@localhost:6379/0

# --- LLM provider: Ollama Cloud (OpenAI-compatible) ---
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
# Model mapping (override per agent in settings if needed)
OLLAMA_MODEL_HEAVY=deepseek-v3.1:671b-cloud
OLLAMA_MODEL_MID=gpt-oss:120b-cloud
OLLAMA_MODEL_LIGHT=gpt-oss:20b-cloud
OLLAMA_MODEL_CODE=qwen3-coder:480b-cloud

# --- Paperclip ---
PAPERCLIP_PORT=3100
PAPERCLIP_DATABASE_URL=postgresql://aic:change_me_strong_password@localhost:5432/paperclip
# With Ollama Cloud the "budget" is a rate-limit/session limit, not $ — see paperclip/budgets.yaml
PAPERCLIP_MONTHLY_BUDGET_USD=100

# --- LangSmith (observability) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ai-company-prod
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- CRM / business integrations ---
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- Messaging ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Finance ---
STRIPE_SECRET_KEY=sk_live_...
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_REFRESH_TOKEN=

# --- Human-in-the-loop approvals ---
APPROVAL_SLACK_CHANNEL=#ai-approvals
FINANCE_APPROVAL_THRESHOLD_EUR=500
CONTRACT_APPROVAL_REQUIRED=true

# --- Admin UI (runtime LLM config at /admin on CrewAI API) ---
# Bearer token required to read/write config/llm.json via the web form.
# Generate a strong random value in production: `openssl rand -hex 32`.
ADMIN_TOKEN=change_me_admin_token
